<Window x:Class="Sentinel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentinel"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20">

            <!-- Header -->

            <TextBlock Text="SENTINEL"
                       FontSize="32"
                       FontWeight="Bold"/>

            <TextBlock Text="Infrastructure &amp; IoT Diagnostics"
                       FontSize="18"
                       Margin="0,0,0,20"/>

            <!-- System Overview -->

            <Border BorderThickness="1"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="SYSTEM OVERVIEW"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal">

                        <StackPanel Margin="25,0">

                            <TextBlock Text="{Binding TotalDevices}"
                                       FontSize="28"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Devices"/>

                        </StackPanel>

                        <StackPanel Margin="25,0">

                            <TextBlock Text="{Binding OnlineDevices}"
                                       FontSize="28"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Online"/>

                        </StackPanel>

                        <StackPanel Margin="25,0">

                            <TextBlock Text="{Binding OnlineDevices}"
                                       FontSize="28"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Alerts"/>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- Devices -->

            <Border BorderThickness="1"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="DEVICES"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

                    <ItemsControl ItemsSource="{Binding Devices}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Grid Margin="0,5">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="150"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"/>

                                    <TextBlock Grid.Column="1"
                                   Text="{Binding Status}"/>

                                </Grid>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>

            <!-- Environment -->

            <Border BorderThickness="1"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="ENVIRONMENT"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <Grid Margin="0,5">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="150"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Temperature"/>

                        <TextBlock Text="{Binding Environment.Temperature}"
                                   Grid.Column="1"/>

                    </Grid>

                    <Grid Margin="0,5">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="150"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Humidity"/>

                        <TextBlock Text="{Binding Environment.Humidity}"
                                   Grid.Column="1"/>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- Alerts -->

            <TextBlock Text="ALERTS"
           FontSize="18"
           FontWeight="Bold"
           Margin="0,0,0,15"/>

            <ItemsControl ItemsSource="{Binding Alerts}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Grid Margin="0,5">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="⚠"
                                       Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="1">

                                <Run Text="{Binding DeviceName}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding Message}"/>

                            </TextBlock>

                        </Grid>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </ScrollViewer>

</Window>